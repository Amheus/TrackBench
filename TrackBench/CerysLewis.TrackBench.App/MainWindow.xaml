<Window x:Class="CerysLewis.TrackBench.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CerysLewis.TrackBench.App.Controls"
        Title="TrackBench" Height="700" Width="1200">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="OpenFolderButton" Content="Open session folder..." Click="OpenFolderButton_Click" Padding="8,4"/>
                <TextBlock x:Name="SessionSummaryText" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <Button Content="Zoom +" Margin="24,0,0,0" Click="ZoomInButton_Click" Padding="8,4"/>
                <Button Content="Zoom -" Margin="4,0,0,0" Click="ZoomOutButton_Click" Padding="8,4"/>
                <Button x:Name="PlayPauseButton" Content="Play ▶" Margin="24,0,0,0" Click="PlayPauseButton_Click" Padding="8,4"/>
            </StackPanel>
            <ProgressBar x:Name="BuildProgressBar" Height="6" Margin="0,4,0,0" Minimum="0" Maximum="1" Visibility="Collapsed"/>
        </StackPanel>
        
        <Border DockPanel.Dock="Right" Width="220" Margin="8,0,0,0" BorderBrush="#333" BorderThickness="1,0,0,0" Padding="8,0,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Markers" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox x:Name="MarkerListBox" ItemsSource="{Binding Markers}"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="MarkerListBox_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="MarkerListBox_PreviewMouseMove"
                         Drop="MarkerListBox_Drop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#E6B43C"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source}" Value="Native">
                                                    <Setter Property="Fill" Value="#5AC88C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollBar x:Name="HorizontalScroll" DockPanel.Dock="Bottom" Orientation="Horizontal"
                   Height="18" ValueChanged="HorizontalScroll_ValueChanged"/>

        <controls:MarkerRulerView x:Name="MarkerRuler" DockPanel.Dock="Top" Height="24" Margin="148,0,0,4"
            Timeline="{Binding Timeline}" Markers="{Binding Markers}"/>

        <ListBox x:Name="TrackList"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.CanContentScroll="True">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="0,4">
                        <DockPanel>
                            <TextBox DockPanel.Dock="Left" Width="140" VerticalAlignment="Center" Margin="0,0,8,0"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            <controls:WaveformView Height="80" Track="{Binding}"
                                Timeline="{Binding DataContext.Timeline, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
